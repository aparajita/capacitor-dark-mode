{
  "name": "demo-pods",
  "version": "6.0.0",
  "description": "An Ionic/Vue demo of the @aparajita/capacitor-dark-mode plugin",
  "private": true,
  "author": "Aparajita Fishman",
  "homepage": "https://github.com/aparajita/capacitor-dark-mode/tree/main/demo-pods",
  "repository": {
    "type": "git",
    "url": "https://github.com/aparajita/capacitor-dark-mode.git",
    "directory": "demo-pods"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 1327",
    "ios.dev": "ionic cap run ios --open --livereload --external",
